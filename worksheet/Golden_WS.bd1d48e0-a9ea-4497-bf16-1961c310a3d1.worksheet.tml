guid: bd1d48e0-a9ea-4497-bf16-1961c310a3d1
obj_id: Golden_WS-bd1d48e0
model:
  name: Golden_WS
  description: 'The Worksheet WS_golden contains information about store transactions such as customer, product, and sales details. Its data can be used to answer questions such as: What is the average household size of customers buying a particular product? What is the average discount offered in a particular region? What is the average sales growth percentage in a particular city? What is the average expense per store? What is the average quantity instock for a particular product type? What is the average floor space of a store? The data also includes date related columns such as date ordered, date shipped, expiry date, and last reorder date. (AI generated)'
  model_tables:
  - name: TS_CAMPAIGN
    fqn: ea9982d3-4bf2-4c27-a492-cc95ad407803
  - name: TS_CUSTOMER
    fqn: b1b4e283-ff5a-4eed-b7a1-900442f20ab6
    joins:
    - with: TS_CAMPAIGN
      referencing_join: TS_CAMPAIGN_to_TS_CUSTOMER
      type: INNER
  - name: TS_SALES
    alias: SalesTable
    fqn: 6d6f2c33-0cf8-496d-ad23-4c90a10c203f
    joins:
    - with: TS_CUSTOMER
      referencing_join: TS_SALES_to_TS_CUSTOMER
    - with: TS_PRODUCT_DETAILS
      'on': '[TS_SALES::PRODUCT_DETAIL_ID] = [TS_PRODUCT_DETAILS::PRODUCT_DETAIL_ID]'
      type: OUTER
      cardinality: MANY_TO_ONE
    - with: TS_STORES
      referencing_join: TS_SALES_to_TS_STORES
  - name: TS_INVENTORY
    fqn: 6abf3460-a685-4ac5-9cb5-9fff61db66d2
    joins:
    - with: TS_PRODUCT_DETAILS
      referencing_join: TS_INVENTORY_to_TS_PRODUCT_DETAILS
    - with: TS_STORES
      referencing_join: TS_INVENTORY_to_TS_STORES
  - name: TS_LOCATION
    fqn: 8a935a3a-eec6-45e1-8ebd-addb5eb67bd2
    joins:
    - with: StateTable
      referencing_join: TS_LOCATION_to_TS_STATES
  - name: TS_STORES
    fqn: 81fe888b-6825-4fa0-954a-bc3f4e48a150
    joins:
    - with: TS_LOCATION
      referencing_join: TS_STORES_to_TS_LOCATION
  - name: TS_PRODUCT_DETAILS
    fqn: 457d8467-6440-4c46-99a3-41302914e9e7
    joins:
    - with: TS_PRODUCTS
      referencing_join: TS_PRODUCT_DETAILS_to_TS_PRODUCTS
  - name: TS_PRODUCTS
    fqn: d9aebd05-7c41-4d40-b51d-87c24b9e996b
  - name: TS_STATES
    alias: StateTable
    fqn: f04ad83b-6d07-43bb-b771-ae067d344990
  formulas:
  - id: formula_Sales Growth %
    name: Sales Growth %
    expr: ( ( group_aggregate ( sum ( [SalesTable::NET_SALES] ) , query_groups ( ) , { month ( [formula_date_orderedtime] ) = month ( [analysis date] ) } ) ) / ( group_aggregate ( sum ( [SalesTable::NET_SALES] ) , query_groups ( ) , { month ( [formula_date_orderedtime] ) = month ( [comparison date] ) } ) ) ) - 1
  - id: formula_TAT
    name: TAT
    expr: diff_days ( [formula_date_shipped] , [formula_date_ordered] )
  - id: formula_age_bucket
    name: age_bucket
    expr: if ( [TS_CUSTOMER::AGE] <= 20 ) then "1. <=20" else if ( [TS_CUSTOMER::AGE] <= 30 ) then "2. 20-30" else if ( [TS_CUSTOMER::AGE] <= 40 ) then "3. 30-40" else if ( [TS_CUSTOMER::AGE] <= 50 ) then "4. 40-50" else if ( [TS_CUSTOMER::AGE] <= 60 ) then "5. 50-60" else if ( [TS_CUSTOMER::AGE] <= 70 ) then "6. 60-70" else "7. >70"
  - id: formula_avg sales per customer
    name: avg sales per customer
    expr: sum ( [SalesTable::NET_SALES] ) / unique count ( [TS_CUSTOMER::CUSTOMER_ID] )
  - id: formula_avg_sales_per_qty_sold
    name: avg_sales_per_qty_sold
    expr: group_sum ( [SalesTable::NET_SALES] , [formula_date_ordered] , [formula_date_shipped] , [TS_PRODUCTS::PRODUCT_TYPE] ) / group_sum ( [SalesTable::SALES_QUANTITY] , [formula_date_ordered] , [formula_date_shipped] , [TS_PRODUCTS::PRODUCT_TYPE] )
  - id: formula_campaign enddate
    name: campaign enddate
    expr: add_days ( [TS_CAMPAIGN::CAMPAIGN_ENDDATE] , diff_days ( today ( ) , to_date ( "2023-12-31" , "%Y-%m-%d" ) ) )
  - id: formula_campaign_startdate
    name: campaign_startdate
    expr: add_days ( [TS_CAMPAIGN::CAMPAIGN_STARTDATE] , diff_days ( today ( ) , to_date ( "2023-12-30" , "%Y-%m-%d" ) ) )
  - id: formula_customer change %
    name: customer change %
    expr: safe_divide ( unique_count_if ( [formula_ly/ty] = "this year" , [TS_CUSTOMER::CUSTOMER_ID] ) - unique_count_if ( [formula_ly/ty] = "last year" , [TS_CUSTOMER::CUSTOMER_ID] ) , unique_count_if ( [formula_ly/ty] = "last year" , [TS_CUSTOMER::CUSTOMER_ID] ) )
  - id: formula_date_orderedtime
    name: date_orderedtime
    expr: add_days ( [SalesTable::ORDER_DATETIME] , diff_days ( today ( ) , to_date ( "2023-12-31" , "%Y-%m-%d" ) ) )
  - id: formula_date_shipped
    name: date_shipped
    expr: add_days ( [SalesTable::SHIP_DATE] , diff_days ( today ( ) , to_date ( "2023-12-31" , "%Y-%m-%d" ) ) )
  - id: formula_dynamic date
    name: dynamic date
    expr: if ( [time grain] = 'daily' ) then [formula_date_ordered] else if ( [time grain] = 'weekly' ) then start_of_week ( [formula_date_ordered] ) else if ( [time grain] = 'monthly' ) then start_of_month ( [formula_date_ordered] ) else start_of_quarter ( [formula_date_ordered] )
  - id: formula_expiry_date
    name: expiry_date
    expr: add_days ( [TS_INVENTORY::EXPIRATION_DATE] , diff_days ( today ( ) , to_date ( "2027-05-15" , "%Y-%m-%d" ) ) )
  - id: formula_inventory_added
    name: inventory_added
    expr: add_days ( [TS_INVENTORY::DATE_ADDED] , diff_days ( today ( ) , to_date ( "2023-10-03" , "%Y-%m-%d" ) ) )
  - id: formula_last_reorderdate
    name: last_reorderdate
    expr: add_days ( [TS_INVENTORY::LAST_REORDERDATE] , diff_days ( today ( ) , to_date ( "2024-09-27" , "%Y-%m-%d" ) ) )
  - id: formula_month bi
    name: month bi
    expr: if ( month_number ( [formula_date_ordered] ) < 10 ) then concat ( '0' , to_string ( month_number ( [formula_date_ordered] ) ) , "-" , month ( [formula_date_ordered] ) ) else concat ( to_string ( month_number ( [formula_date_ordered] ) ) , "-" , month ( [formula_date_ordered] ) )
  - id: formula_monthName
    name: monthName
    expr: month ( [formula_date_ordered] )
  - id: formula_movAvgQTY
    name: movAvgQTY
    expr: if ( [rolling_params] = 'rolling 7 day avg' ) then moving_average ( [SalesTable::SALES_QUANTITY] , 6 , 0 , [formula_date_ordered] ) else if ( [rolling_params] = 'rolling 14 day avg' ) then moving_average ( [SalesTable::SALES_QUANTITY] , 13 , 0 , [formula_date_ordered] ) else if ( [rolling_params] = 'rolling 30 day avg' ) then moving_average ( [SalesTable::SALES_QUANTITY] , 29 , 0 , [formula_date_ordered] ) else moving_average ( [SalesTable::SALES_QUANTITY] , 59 , 0 , [formula_date_ordered] )
  - id: formula_quantity change %
    name: quantity change %
    expr: safe_divide ( sum_if ( [formula_ly/ty] = "this year" , [SalesTable::SALES_QUANTITY] ) - sum_if ( [formula_ly/ty] = "last year" , [SalesTable::SALES_QUANTITY] ) , sum_if ( [formula_ly/ty] = "last year" , [SalesTable::SALES_QUANTITY] ) )
  - id: formula_sales change %
    name: sales change %
    expr: safe_divide ( sum_if ( [formula_ly/ty] = "this year" , [SalesTable::NET_SALES] ) - sum_if ( [formula_ly/ty] = "last year" , [SalesTable::NET_SALES] ) , sum_if ( [formula_ly/ty] = "last year" , [SalesTable::NET_SALES] ) )
  - id: formula_ly/ty
    name: ly/ty
    expr: if ( to_integer ( [formula_year#] ) = group_max ( to_integer ( [formula_year#] ) ) ) then "this year" else if ( to_integer ( [formula_year#] ) = group_max ( to_integer ( [formula_year#] ) ) - 1 ) then "last year" else "na"
  - id: formula_sales_attr_in
    name: sales_attr_in
    expr: if ( [StateTable::REGION] = 'northwest' or isnull ( [StateTable::REGION] ) ) then false else true
  - id: formula_sales_params
    name: sales_params
    expr: '[SalesTable::NET_SALES] * [int_params]'
  - id: formula_year#
    name: year#
    expr: year ( [formula_date_ordered] )
    properties:
      column_type: ATTRIBUTE
  - id: formula_date_ordered
    name: date_ordered
    expr: add_days ( [SalesTable::ORDER_DATE] , diff_days ( today ( ) , to_date ( "2023-12-31" , "%Y-%m-%d" ) ) )
  columns:
  - name: Region
    column_id: StateTable::REGION
    properties:
      column_type: ATTRIBUTE
      synonyms:
      - Area
      ai_context: Geographic territory classification for market analysis, enabling regional performance comparisons and territory-based strategic planning.
  - name: date_ordered
    formula_id: formula_date_ordered
    properties:
      column_type: ATTRIBUTE
      synonyms:
      - order_date
      - date_of_order
      calendar: pe_cc_oct04_2025
      default_date_bucket: MONTHLY
      ai_context: Calendar date when customer placed their order, serving as the initial timestamp for order fulfillment tracking and sales cycle analysis.
  - name: date_orderedtime
    formula_id: formula_date_orderedtime
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      synonyms:
      - Order Date
      - Order Placed Date
      calendar: pe_cc_oct04_2025
      default_date_bucket: MONTHLY
      ai_context: Precise datetime stamp capturing exact moment order was placed, enabling detailed time-of-day purchasing pattern analysis and operational timing insights.
  - name: date_shipped
    formula_id: formula_date_shipped
    properties:
      column_type: ATTRIBUTE
      synonyms:
      - Dispatch Date
      - Delivery Date
      ai_context: Date when order was dispatched from warehouse to customer, critical for measuring fulfillment speed and delivery performance metrics.
  - name: campaign_startdate
    formula_id: formula_campaign_startdate
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      synonyms:
      - commencement_date
      - initiation_date
      calendar: pe_cc_oct04_2025
      ai_context: Launch date marking when marketing campaign became active, essential for measuring campaign duration and timing effectiveness analysis.
  - name: campaign enddate
    formula_id: formula_campaign enddate
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      synonyms:
      - Campaign Termination Date
      - Campaign Finishing Date
      calendar: pe_cc_oct04_2025
      ai_context: Final date when marketing campaign concluded, used to calculate total campaign duration and post-campaign performance evaluation.
  - name: inventory_added
    formula_id: formula_inventory_added
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      synonyms:
      - stock_added
      - supply_added
      ai_context: Date when new stock was received and added to warehouse inventory, crucial for inventory turnover and supply chain timing analysis.
  - name: last_reorderdate
    formula_id: formula_last_reorderdate
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      synonyms:
      - Last Reorder Date
      - Final Reorder Date
      ai_context: Most recent date when product was reordered for inventory replenishment, indicating demand patterns and restocking frequency.
  - name: expiry_date
    formula_id: formula_expiry_date
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      synonyms:
      - termination_date
      - expiration_date
      calendar: pe_cc_oct04_2025
      ai_context: Product expiration date for perishable or time-sensitive inventory items, essential for inventory management and loss prevention.
  - name: TAT
    formula_id: formula_TAT
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Turnaround Time
      - Response Time
      ai_context: Turnaround time measuring days between order placement and delivery completion, indicating fulfillment efficiency and customer service quality.
  - name: Sales Growth %
    formula_id: formula_Sales Growth %
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Growth Rate
      - Sales Increase
      format_pattern: '#.0%'
      ai_context: Percentage increase in sales revenue compared to previous period, measuring business expansion and revenue performance trends.
  - name: age_bucket
    formula_id: formula_age_bucket
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      synonyms:
      - Age Group
      - Age Range
      ai_context: Categorized age ranges for demographic segmentation, enabling generational analysis and age-targeted marketing strategies.
  - name: avg_sales_per_qty_sold
    formula_id: formula_avg_sales_per_qty_sold
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Average Sales
      - Sales per Quantity
      ai_context: Average revenue generated per unit sold, indicating pricing effectiveness and product value realization in transactions.
  - name: month bi
    formula_id: formula_month bi
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      synonym_type: USER_DEFINED
      ai_context: Business intelligence month classification for bi-monthly reporting periods, supporting specialized financial and operational reporting cycles.
  - name: sales_params
    formula_id: formula_sales_params
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - sales_parameters
      - sales_metrics
      synonym_type: AUTO_GENERATED
      ai_context: Configurable sales parameters for analytical modeling, supporting dynamic calculations and performance measurement adjustments.
  - name: avg sales per customer
    formula_id: formula_avg sales per customer
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Average Revenue per Customer
      - Customer Sales Average
      synonym_type: AUTO_GENERATED
      ai_context: Mean revenue generated per individual customer, measuring customer value and purchase behavior effectiveness.
  - name: year#
    formula_id: formula_year#
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      synonyms:
      - Year Number
      - Calendar Year
      synonym_type: AUTO_GENERATED
      ai_context: Four-digit calendar year identifier enabling annual trend analysis, year-over-year comparisons, and multi-year performance tracking.
  - name: ly/ty
    formula_id: formula_ly/ty
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      synonyms:
      - Last Year/This Year
      - Previous Year/Current Year
      synonym_type: AUTO_GENERATED
      ai_context: Last year versus this year comparison indicator, enabling period-over-period variance analysis and growth trend identification.
  - name: sales change %
    formula_id: formula_sales change %
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - sales_variation_percentage
      - sales_shift_rate
      synonym_type: AUTO_GENERATED
      ai_context: Percentage variation in sales volume between comparative periods, tracking sales momentum and business performance shifts.
  - name: quantity change %
    formula_id: formula_quantity change %
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Quantity Variation Percentage
      - Stock Change Rate
      format_pattern: '#.000%'
      synonym_type: AUTO_GENERATED
      ai_context: Percentage change in units sold between periods, measuring demand fluctuations independent of pricing changes.
  - name: customer change %
    formula_id: formula_customer change %
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - customer_variation_percentage
      - client_change_rate
      synonym_type: AUTO_GENERATED
      ai_context: Percentage variation in customer count between periods, tracking customer acquisition and retention effectiveness.
  - name: monthName
    formula_id: formula_monthName
    properties:
      column_type: ATTRIBUTE
      synonyms:
      - month_title
      - month_label
      synonym_type: AUTO_GENERATED
      ai_context: Full month name in text format, facilitating seasonal analysis and month-based performance comparisons across business cycles.
  - name: movAvg
    formula_id: formula_movAvgQTY
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Moving Average Quantity
      - Rolling Average Stock
      synonym_type: AUTO_GENERATED
      ai_context: Moving average calculation smoothing short-term fluctuations to reveal underlying trends in sales or performance data.
  - name: sales_attr_in
    formula_id: formula_sales_attr_in
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      synonyms:
      - Sales Attributes
      - Sales Characteristics
      synonym_type: AUTO_GENERATED
      ai_context: Boolean flag indicating whether sales attributes are included in current analysis, controlling data scope and calculation parameters.
  - name: dynamic date
    formula_id: formula_dynamic date
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      synonyms:
      - Variable Date
      - Flexible Date
      calendar: pe_cc_oct04_2025
      synonym_type: AUTO_GENERATED
      ai_context: Flexible date field that adjusts based on analytical context, supporting various temporal calculations and relative date comparisons.
  - name: Store_Store Id
    column_id: TS_STORES::STORE_ID
    properties:
      column_type: ATTRIBUTE
      ai_context: Primary store location identifier for operational tracking, enabling store-specific performance analysis and management reporting.
  - name: State Name
    column_id: TS_LOCATION::STATE_NAME
    properties:
      column_type: ATTRIBUTE
      synonyms:
      - State Title
      - State Designation
      geo_config:
        region_name:
          country: UNITED STATES
          region_name: state
      custom_order:
      - California
      - Florida
      - New York
      - Michigan
      - Oregon
      ai_context: State-level geographic identifier for location-based analysis, supporting state-specific performance tracking and regulatory compliance.
  - name: County Name
    column_id: TS_LOCATION::COUNTY_NAME
    properties:
      column_type: ATTRIBUTE
      synonyms:
      - County Title
      - County Designation
      geo_config:
        region_name:
          country: UNITED STATES
          region_name: county
      ai_context: County-level administrative division for granular geographic analysis, enabling local market penetration and demographic studies.
  - name: Campaign Channel
    column_id: TS_CAMPAIGN::CAMPAIGN_CHANNEL
    properties:
      column_type: ATTRIBUTE
      synonyms:
      - Campaign Medium
      - Campaign Platform
      ai_context: Marketing medium used to reach customers, essential for channel effectiveness analysis and media mix optimization.
  - name: Discount Pct
    column_id: SalesTable::DISCOUNT_PCT
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Discount Percentage
      - Discount Rate
      ai_context: Percentage reduction applied to original product price, measuring promotional impact and pricing strategy effectiveness.
  - name: Net Sales
    column_id: SalesTable::NET_SALES
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Net Revenue
      - Net Profit
      ai_context: Total revenue after deducting returns, discounts, and allowances, representing actual income generated from sales transactions.
  - name: Campaign Status
    column_id: TS_CAMPAIGN::CAMPAIGN_STATUS
    properties:
      column_type: ATTRIBUTE
      synonyms:
      - Campaign Condition
      - Campaign State
      ai_context: Current phase of marketing campaign lifecycle, tracking whether campaigns are planned, active, or completed.
  - name: Budget
    column_id: TS_CAMPAIGN::BUDGET
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Allocation
      - Allowance
      currency_type:
        iso_code: USD
      ai_context: Allocated financial resources for marketing campaign, enabling cost management and return on investment calculations.
  - name: Age
    column_id: TS_CUSTOMER::AGE
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      synonyms:
      - Years
      - Generation
      ai_context: Customer's chronological age in years, fundamental demographic attribute for customer profiling and targeted marketing analysis.
  - name: Gender
    column_id: TS_CUSTOMER::GENDER
    properties:
      column_type: ATTRIBUTE
      synonyms:
      - Sex
      custom_order:
      - female
      - male
      ai_context: Customer's gender classification for demographic analysis, enabling gender-based marketing strategies and product preference studies.
  - name: Income
    column_id: TS_CUSTOMER::INCOME
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Revenue
      - Profit
      ai_context: Customer's annual earnings level, crucial for economic segmentation and purchasing power analysis in market research.
  - name: Household Size
    column_id: TS_CUSTOMER::HOUSEHOLD_SIZE
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Household Number
      - Household Measurement
      ai_context: Number of people living in customer's household, affecting purchasing patterns and family-oriented product targeting strategies.
  - name: Marital Status
    column_id: TS_CUSTOMER::MARITAL_STATUS
    properties:
      column_type: ATTRIBUTE
      synonyms:
      - Marriage Status
      - Matrimonial Status
      ai_context: Customer's relationship status classification, influencing buying behavior and lifestyle-based marketing approach development.
  - name: Inventory Id
    column_id: TS_INVENTORY::INVENTORY_ID
    properties:
      column_type: ATTRIBUTE
      synonyms:
      - Inventory Number
      ai_context: Unique stock record identifier for warehouse management, enabling precise inventory tracking and stock movement analysis.
  - name: Quantity Instock
    column_id: TS_INVENTORY::QUANTITY_INSTOCK
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Quantity in Stock
      - Quantity in Store
      currency_type:
        is_browser: true
      ai_context: Current number of units available in warehouse, critical for inventory management and stock availability monitoring.
  - name: City
    column_id: TS_LOCATION::CITY
    properties:
      column_type: ATTRIBUTE
      synonyms:
      - Town
      - Municipality
      geo_config:
        country: true
      ai_context: Municipal location identifier for precise geographic targeting, supporting city-level market analysis and local business strategies.
  - name: Population
    column_id: TS_LOCATION::POPULATION
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Crowd
      - People
      ai_context: Total number of residents in geographic area, providing market size context for penetration analysis and opportunity assessment.
  - name: Density
    column_id: TS_LOCATION::DENSITY
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Compactness
      - Concentration
      ai_context: Population concentration per geographic unit, indicating market saturation potential and customer accessibility factors.
  - name: Product Name
    description: product name
    column_id: TS_PRODUCT_DETAILS::PRODUCT_NAME
    properties:
      column_type: ATTRIBUTE
      synonyms:
      - Product Title
      - Product Description
      ai_context: Descriptive title identifying specific merchandise item, essential for product performance tracking and inventory management.
  - name: Product Price
    column_id: TS_PRODUCT_DETAILS::PRODUCT_PRICE
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Product Worth
      - Product Cost
      ai_context: Monetary value assigned to individual product, representing pricing strategy and revenue potential per item sold.
  - name: Product Type
    column_id: TS_PRODUCTS::PRODUCT_TYPE
    properties:
      column_type: ATTRIBUTE
      synonyms:
      - Product Category
      - Product Class
      ai_context: Category classification grouping similar products, enabling category-level analysis and merchandise planning strategies.
  - name: Sale Id
    column_id: SalesTable::SALE_ID
    properties:
      column_type: ATTRIBUTE
      synonyms:
      - Transaction Id
      - Sale Number
      ai_context: Unique transaction identifier for individual sales events, enabling precise transaction tracking and customer journey analysis.
  - name: SalesStore Id
    column_id: SalesTable::STORE_ID
    properties:
      column_type: ATTRIBUTE
      synonyms:
      - Store Number
      ai_context: Store identifier specifically for sales transaction tracking, linking sales events to specific retail locations.
  - name: Product Detail Id
    description: prod detail id
    column_id: SalesTable::PRODUCT_DETAIL_ID
    properties:
      column_type: ATTRIBUTE
      synonyms:
      - Product Detail Number
      - Product Detail Reference
      ai_context: Granular product specification identifier capturing detailed product variations, supporting precise inventory and sales tracking.
  - name: Product Id
    column_id: SalesTable::PRODUCT_ID
    properties:
      column_type: ATTRIBUTE
      synonyms:
      - Item Id
      - Product Number
      ai_context: Primary product identifier linking items across systems, fundamental for product lifecycle tracking and catalog management.
  - name: Customer Id
    column_id: SalesTable::CUSTOMER_ID
    properties:
      column_type: ATTRIBUTE
      synonyms:
      - Customer Number
      ai_context: Unique alphanumeric identifier for individual customers, enabling customer tracking and personalized service across transactions.
  - name: Shipmode
    column_id: SalesTable::SHIPMODE
    properties:
      column_type: ATTRIBUTE
      synonyms:
      - Delivery Mode
      ai_context: Transportation method selected for order delivery, affecting shipping costs, delivery speed, and customer satisfaction.
  - name: Sales Quantity
    description: sales qty
    column_id: SalesTable::SALES_QUANTITY
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Sales Amount
      - Sales Volume
      ai_context: Total number of units sold in transaction, representing volume-based sales performance and demand measurement.
  - name: Tax
    column_id: SalesTable::TAX
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Levy
      - Duty
      ai_context: Government-imposed levy amount added to purchase total, representing tax obligations and regulatory compliance costs.
  - name: Store Status
    column_id: TS_STORES::STORE_STATUS
    properties:
      column_type: ATTRIBUTE
      synonyms:
      - Store Condition
      - Store State
      ai_context: Current operational state of retail location, indicating whether store is actively serving customers or temporarily closed.
  - name: Floor Space
    column_id: TS_STORES::FLOOR_SPACE
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Floor Area
      - Floor Measurement
      ai_context: Total retail area available for customer shopping, measuring store capacity and space utilization efficiency.
  - name: Expense
    column_id: TS_STORES::EXPENSE
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Outlay
      - Cost
      ai_context: Total operational costs incurred by store, including rent, utilities, and staffing for profitability analysis.
  - name: store_size
    column_id: TS_STORES::STORE_SIZE
    properties:
      column_type: ATTRIBUTE
      synonyms:
      - store_area
      - store_dimension
      ai_context: Categorical classification of store dimensions, ranging from extra-small to extra-large for capacity and performance comparison.
  properties:
    is_bypass_rls: false
    join_progressive: false
    spotter_config:
      is_spotter_enabled: true
