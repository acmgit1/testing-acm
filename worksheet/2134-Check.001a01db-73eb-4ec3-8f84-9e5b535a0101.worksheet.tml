    joins:
    - with: 2134_CUSTOMER
      referencing_join: LINEORDER_CUSTOMER
  formulas:
  - id: formula_ModeOfShipment
    name: ModeOfShipment
    expr: if ( [2134_LINEORDER::LO_SHIPMODE] = [param1] ) then [param1] else null
  - id: formula_Region Formulka
    name: Region Formulka
    expr: '[2134_CUSTOMER::C_REGION] '
  - id: formula_abc
    name: abc
    expr: '[123]'
  columns:
