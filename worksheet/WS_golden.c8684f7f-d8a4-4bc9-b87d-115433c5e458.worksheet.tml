      - value: '0.1'
      - value: '0.2'
      - value: '0.25'
      - value: '0.5'
      - value: '0.75'
      - value: '0.9'
      - value: '0.95'
      - value: '0.975'
      - value: '0.99'
      - value: '1.0'
    description: ''
  - id: f27cd61b-750c-4d08-b4ea-c392bd8be8f7
