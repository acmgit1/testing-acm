guid: c8684f7f-d8a4-4bc9-b87d-115433c5e458
obj_id: WS_golden-c8684f7f
model:
  name: WS_golden
  description: 'The Worksheet WS_golden contains information about store transactions such as customer, product, and sales details. Its data can be used to answer questions such as: What is the average household size of customers buying a particular product? What is the average discount offered in a particular region? What is the average sales growth percentage in a particular city? What is the average expense per store? What is the average quantity instock for a particular product type? What is the average floor space of a store? The data also includes date related columns such as date ordered, date shipped, expiry date, and last reorder date. (AI generated)'
  model_tables:
  - name: TS_CAMPAIGN
    fqn: ea9982d3-4bf2-4c27-a492-cc95ad407803
  - name: TS_CUSTOMER
    fqn: b1b4e283-ff5a-4eed-b7a1-900442f20ab6
    joins:
    - with: TS_CAMPAIGN
      referencing_join: TS_CAMPAIGN_to_TS_CUSTOMER
      type: INNER
  - name: TS_SALES
    fqn: 6d6f2c33-0cf8-496d-ad23-4c90a10c203f
    joins:
    - with: TS_CUSTOMER
      referencing_join: TS_SALES_to_TS_CUSTOMER
    - with: TS_PRODUCT_DETAILS
      referencing_join: TS_SALES_to_TS_PRODUCT_DETAILS
    - with: TS_STORES
      referencing_join: TS_SALES_to_TS_STORES
  - name: TS_INVENTORY
    fqn: 6abf3460-a685-4ac5-9cb5-9fff61db66d2
    joins:
    - with: TS_PRODUCT_DETAILS
      referencing_join: TS_INVENTORY_to_TS_PRODUCT_DETAILS
    - with: TS_STORES
      referencing_join: TS_INVENTORY_to_TS_STORES
  - name: TS_LOCATION
    fqn: 8a935a3a-eec6-45e1-8ebd-addb5eb67bd2
    joins:
    - with: TS_STATES
      referencing_join: TS_LOCATION_to_TS_STATES
  - name: TS_STORES
    fqn: 81fe888b-6825-4fa0-954a-bc3f4e48a150
    joins:
    - with: TS_LOCATION
      referencing_join: TS_STORES_to_TS_LOCATION
  - name: TS_PRODUCT_DETAILS
    fqn: 457d8467-6440-4c46-99a3-41302914e9e7
    joins:
    - with: TS_PRODUCTS
      referencing_join: TS_PRODUCT_DETAILS_to_TS_PRODUCTS
  - name: TS_PRODUCTS
    fqn: d9aebd05-7c41-4d40-b51d-87c24b9e996b
  - name: TS_STATES
    fqn: f04ad83b-6d07-43bb-b771-ae067d344990
  formulas:
  - id: formula_Sales Growth %
    name: Sales Growth %
    expr: ( ( group_aggregate ( sum ( [TS_SALES::NET_SALES] ) , query_groups ( ) , { month ( [formula_date_orderedtime] ) = month ( [analysis date] ) } ) ) / ( group_aggregate ( sum ( [TS_SALES::NET_SALES] ) , query_groups ( ) , { month ( [formula_date_orderedtime] ) = month ( [comparison date] ) } ) ) ) - 1
  - id: formula_TAT
    name: TAT
    expr: diff_days ( [formula_date_shipped] , [formula_date_orderedtime] )
  - id: formula_age_bucket
    name: age_bucket
    expr: if ( [TS_CUSTOMER::AGE] <= 20 ) then "1. <=20" else if ( [TS_CUSTOMER::AGE] <= 30 ) then "2. 20-30" else if ( [TS_CUSTOMER::AGE] <= 40 ) then "3. 30-40" else if ( [TS_CUSTOMER::AGE] <= 50 ) then "4. 40-50" else if ( [TS_CUSTOMER::AGE] <= 60 ) then "5. 50-60" else if ( [TS_CUSTOMER::AGE] <= 70 ) then "6. 60-70" else "7. >70"
  - id: formula_avg_sales_per_qty_sold
    name: avg_sales_per_qty_sold
    expr: group_sum ( [TS_SALES::NET_SALES] , [formula_date_ordered] , [formula_date_shipped] , [TS_PRODUCTS::PRODUCT_TYPE] ) / group_sum ( [TS_SALES::SALES_QUANTITY] , [formula_date_ordered] , [formula_date_shipped] , [TS_PRODUCTS::PRODUCT_TYPE] )
  - id: formula_campaign enddate
    name: campaign enddate
    expr: add_days ( [TS_CAMPAIGN::CAMPAIGN_ENDDATE] , diff_days ( today ( ) , to_date ( "2023-12-31" , "%Y-%m-%d" ) ) )
  - id: formula_campaign_startdate
    name: campaign_startdate
    expr: add_days ( [TS_CAMPAIGN::CAMPAIGN_STARTDATE] , diff_days ( today ( ) , to_date ( "2023-12-30" , "%Y-%m-%d" ) ) )
  - id: formula_date_orderedtime
    name: date_orderedtime
    expr: add_days ( [TS_SALES::ORDER_DATETIME] , diff_days ( today ( ) , to_date ( "2023-12-31" , "%Y-%m-%d" ) ) )
  - id: formula_date_shipped
    name: date_shipped
    expr: add_days ( [TS_SALES::SHIP_DATE] , diff_days ( today ( ) , to_date ( "2023-12-31" , "%Y-%m-%d" ) ) )
  - id: formula_expiry_date
    name: expiry_date
    expr: add_days ( [TS_INVENTORY::EXPIRATION_DATE] , diff_days ( today ( ) , to_date ( "2027-05-15" , "%Y-%m-%d" ) ) )
  - id: formula_grpSumCount
    name: grpSumCount
    expr: '[formula_grpSum] / [formula_grpCount]'
  - id: formula_grpCount
    name: grpCount
    expr: group_count ( [TS_SALES::SALE_ID] , [TS_STATES::REGION] , [TS_LOCATION::STATE_NAME] , [TS_LOCATION::COUNTY_NAME] , [TS_LOCATION::CITY] , [TS_STORES::STORE_ID] )
  - id: formula_grpSum
    name: grpSum
    expr: group_sum ( [TS_SALES::NET_SALES] , [TS_STATES::REGION] , [TS_LOCATION::STATE_NAME] , [TS_LOCATION::COUNTY_NAME] , [TS_LOCATION::CITY] , [TS_STORES::STORE_ID] )
  - id: formula_inventory_added
    name: inventory_added
    expr: add_days ( [TS_INVENTORY::DATE_ADDED] , diff_days ( today ( ) , to_date ( "2023-10-03" , "%Y-%m-%d" ) ) )
  - id: formula_last_reorderdate
    name: last_reorderdate
    expr: add_days ( [TS_INVENTORY::LAST_REORDERDATE] , diff_days ( today ( ) , to_date ( "2024-09-27" , "%Y-%m-%d" ) ) )
  - id: formula_month bi
    name: month bi
    expr: if ( month_number ( [formula_date_ordered] ) < 10 ) then concat ( '0' , to_string ( month_number ( [formula_date_ordered] ) ) , "-" , month ( [formula_date_ordered] ) ) else concat ( to_string ( month_number ( [formula_date_ordered] ) ) , "-" , month ( [formula_date_ordered] ) )
  - id: formula_mvAvg
    name: mvAvg
    expr: moving_average ( [formula_tax+disc+prod_price] , 1 , - 1 , [formula_date_ordered] )
  - id: formula_mvSum
    name: mvSum
    expr: moving_sum ( [formula_sales+qty+tax+disc+inc] , 1 , 1 , [formula_date_ordered] )
  - id: formula_date_ordered
    name: date_ordered
    expr: add_days ( [TS_SALES::ORDER_DATE] , diff_days ( today ( ) , to_date ( "2023-12-31" , "%Y-%m-%d" ) ) )
  - id: formula_tax+disc+prod_price
    name: tax+disc+prod_price
    expr: '[formula_tax+disc] + [formula_sales+qty+tax+disc+inc] + [TS_PRODUCT_DETAILS::PRODUCT_PRICE]'
  - id: formula_sales+qty+tax+disc+inc
    name: sales+qty+tax+disc+inc
    expr: '[formula_sales+qty] + [formula_tax+disc] + [TS_CUSTOMER::INCOME]'
  - id: formula_sales+qty
    name: sales+qty
    expr: '[TS_SALES::NET_SALES] + [TS_SALES::SALES_QUANTITY]'
  - id: formula_tax+disc
    name: tax+disc
    expr: '[TS_SALES::TAX] + [TS_SALES::DISCOUNT_PCT]'
  filters:
  - column:
    - date_ordered
    oper: between
    values:
    - 10/03/2000
    - 12/31/2030
  columns:
  - name: date_ordered
    formula_id: formula_date_ordered
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      synonyms:
      - order_date
      - date_of_order
  - name: Campaign Channel
    column_id: TS_CAMPAIGN::CAMPAIGN_CHANNEL
    properties:
      column_type: ATTRIBUTE
      synonyms:
      - Campaign Medium
      - Campaign Platform
  - name: date_orderedtime
    formula_id: formula_date_orderedtime
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      synonyms:
      - Order Date
      - Order Placed Date
  - name: date_shipped
    formula_id: formula_date_shipped
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      synonyms:
      - Dispatch Date
      - Delivery Date
  - name: campaign_startdate
    formula_id: formula_campaign_startdate
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      synonyms:
      - commencement_date
      - initiation_date
  - name: campaign enddate
    formula_id: formula_campaign enddate
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      synonyms:
      - Campaign Termination Date
      - Campaign Finishing Date
  - name: inventory_added
    formula_id: formula_inventory_added
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      synonyms:
      - stock_added
      - supply_added
  - name: last_reorderdate
    formula_id: formula_last_reorderdate
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      synonyms:
      - Last Reorder Date
      - Final Reorder Date
  - name: expiry_date
    formula_id: formula_expiry_date
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      synonyms:
      - termination_date
      - expiration_date
  - name: TAT
    formula_id: formula_TAT
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Turnaround Time
      - Response Time
  - name: Sales Growth %
    formula_id: formula_Sales Growth %
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Growth Rate
      - Sales Increase
  - name: age_bucket
    formula_id: formula_age_bucket
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      synonyms:
      - Age Group
      - Age Range
  - name: avg_sales_per_qty_sold
    formula_id: formula_avg_sales_per_qty_sold
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Average Sales
      - Sales per Quantity
  - name: month bi
    formula_id: formula_month bi
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      synonym_type: USER_DEFINED
  - name: tax+disc
    formula_id: formula_tax+disc
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
  - name: sales+qty
    formula_id: formula_sales+qty
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
  - name: sales+qty+tax+disc+inc
    formula_id: formula_sales+qty+tax+disc+inc
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
  - name: tax+disc+prod_price
    formula_id: formula_tax+disc+prod_price
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
  - name: grpSum
    formula_id: formula_grpSum
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
  - name: grpCount
    formula_id: formula_grpCount
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
  - name: grpSumCount
    formula_id: formula_grpSumCount
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
  - name: mvSum
    formula_id: formula_mvSum
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
  - name: mvAvg
    formula_id: formula_mvAvg
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
  - name: Campaign Status
