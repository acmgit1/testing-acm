    data_type: DOUBLE
    default_value: '0.11'
    range_config:
      range_min: '0.0'
      range_max: '1.0'
      include_min: true
      include_max: true
    description: ''
  - id: 23b61c9a-aa88-4978-b114-83dc379cca8b
    name: int_params
    data_type: INT64
    default_value: '1'
    description: Integer params ( Any )
  - id: 3b5f8534-a23e-455f-adcb-17889bd6f973
